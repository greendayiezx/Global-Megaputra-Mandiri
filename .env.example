# Copy to .env for local development. Never commit real secrets.
# All variables are optional for local development without Docker.

# Show clearly-labelled demo data (Demo Provider 00X) and demo accounts. Never true in production.
APP_SHOW_DEMO_DATA=true

# Database: embedded PostgreSQL (PGlite) by default — no Docker needed.
DB_DRIVER=pglite
PGLITE_DATA_DIR=.data/pglite
# For a real PostgreSQL server instead:
# DB_DRIVER=postgres
# DATABASE_URL=postgres://user:password@host:5432/gmm
# DB_AUTO_MIGRATE=false

# Sessions
SESSION_COOKIE_NAME=gmm_session
SESSION_TTL_HOURS=168
# Long random string (>= 32 bytes). Required in production.
RATE_LIMIT_SECRET=
# Set true only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# Pricing policy — TODO_BUSINESS_DECISION D3/D4. Leave empty until decided;
# the UI then shows every fee but marks the total as pending.
# PRICING_TAX_RATE_BPS=1100        (basis points; 1100 = 11%)
# PRICING_CHARGE_FIRST_MONTH_UPFRONT=true
PRICING_TAX_RATE_BPS=
PRICING_CHARGE_FIRST_MONTH_UPFRONT=

# Server Actions allowed origins (CSRF hardening), comma-separated host[:port].
APP_ALLOWED_ORIGINS=
